// Всё общее лежит в common.jsonc.
//
// Трей на всех барах. Версия с одним треем проверена 31.08.2026 — ПКМ от этого
// не починился, так что дело не в конкуренции dbusmenu-клиентов.
[
  {
    // Ноутбук — рабочий экран, полный бар и единственный трей.
    "include": ["~/.config/waybar/common.jsonc"],
    "output": "eDP-1"
  },
  {
    // 27" — полный бар, но без трея.
    "include": ["~/.config/waybar/common.jsonc"],
    "output": "HDMI-A-1",
    "modules-right": [
      "pulseaudio",
      "custom/powerprofile",
      "cpu",
      "custom/temp",
      "memory",
      "battery",
      "tray",
      "hyprland/language",
      "clock",
      "custom/swaync",
      "custom/power"
    ]
  },
  {
    // Портретный монитор (transform 3) => ширина 1080, модули не влезают.
    // Порт может отдать его как DP-1/DP-2/DP-3 — перечисляем все.
    "include": ["~/.config/waybar/common.jsonc"],
    "output": ["DP-1", "DP-2", "DP-3"],
    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
      "tray",
      "hyprland/language",
      "clock",
      "custom/power"
    ],
    // ponytail: без заголовков окон — они и съедали ширину; название в тултипе
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 24,
      "spacing": 3,
      "on-click": "activate",
      "on-click-middle": "close",
      "tooltip-format": "{title}"
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": "{icon} {capacity}%"
    }
  }
]
