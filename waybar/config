// Широкие мониторы — полный бар. Всё общее лежит в common.jsonc.
[
  {
    "include": ["~/.config/waybar/common.jsonc"],
    // Усі DP-виходи: залежно від порту й USB-C режиму монітор може
    // з'явитись як DP-1, DP-2 чи DP-3 — раніше був лише DP-1, і на DP-2
    // бар просто не показувався.
    "output": ["eDP-1", "DP-1", "DP-2", "DP-3"]
  },
  // HDMI-A-1 повёрнут (transform 3) => ширина 1080, модули не влезают.
  {
    "include": ["~/.config/waybar/common.jsonc"],
    "output": "HDMI-A-1",
    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
//      "pulseaudio",
//      "custom/temp",
//      "memory",
//      "battery",
      "tray",
      "hyprland/language",
      "clock",
//      "custom/swaync",
      "custom/power"
    ],
    // ponytail: без заголовков окон — они и съедали ширину; название в тултипе
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 24,
      "spacing": 3,
      "on-click": "activate",
      "on-click-middle": "close",
      "tooltip-format": "{title}"
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": "{icon} {capacity}%"
    }
  }
]
